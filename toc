PROG=$(basename "$0")

checkDependencies() {
   local cmd
   for cmd in gawk openssl mktemp date cat ; do
      if ! command -v "$cmd" > /dev/null 2>&1 ; then
         echo "$PROG: couldn't find '$cmd' on the path. Please install it before using this utility." >&2
         exit 1
      fi
   done
}

# Temporary files are removed on exit, whatever the outcome.
TMPFILES=()
cleanup() {
   if [ ${#TMPFILES[@]} -gt 0 ]; then
      rm -f "${TMPFILES[@]}"
   fi
}
trap cleanup EXIT

newTempFile() {
   local f
   f=$(mktemp "${TMPDIR:-/tmp}/toc.XXXXXXX") || exit 1
   TMPFILES+=("$f")
   echo "$f"
}

# Replace the contents of $2 with $1, keeping $2's inode, permissions,
# ownership, hard links and symlinks intact.
overwriteFile() {
   cat "$1" > "$2"
}

# Matches a line holding only a TOC marker (whitespace and a CR allowed).
AWK_MARKERS='
function isStart(s) { return s ~ /^[ \t]*<!-- TOC START -->[ \t]*\r?$/ }
function isEnd(s)   { return s ~ /^[ \t]*<!-- TOC END -->[ \t]*\r?$/ }
'

# Prints one ToC line per heading of the given markdown file.
# shellcheck disable=SC2016  # awk code, not shell expansions
AWK_HEADINGS='
function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }

# Replace links and images with their text: [text](url) -> text
function delink(s,   t) {
   while (match(s, /!?\[[^\]]*\]\([^)]*\)/)) {
      t = substr(s, RSTART, RLENGTH)
      sub(/^!?\[/, "", t)
      sub(/\]\(.*$/, "", t)
      s = substr(s, 1, RSTART - 1) t substr(s, RSTART + RLENGTH)
   }
   return s
}

# The anchor GitHub generates: lower-case, punctuation other than "-" and
# "_" removed, and every space replaced with "-".
function anchor(s,   a) {
   a = tolower(s)
   gsub(/[^[:alnum:] _-]/, "", a)
   gsub(/ /, "-", a)
   return a
}

function emit(level, title,   a, real, indent, i) {
   title = delink(trim(title))
   if (title == "")
      return
   a = anchor(title)
   if (a in seen) {
      real = a "-" seen[a]
      seen[a]++
   } else {
      real = a
      seen[a] = 1
   }
   indent = ""
   for (i = 0; i < level; i++)
      indent = indent "  "
   print indent "* [" title "](#" real ")"
}

{ sub(/\r$/, "") }

# YAML front matter
NR == 1 && /^---[ \t]*$/ { frontmatter = 1; next }
frontmatter { if (/^(---|\.\.\.)[ \t]*$/) frontmatter = 0; next }

# Fenced code blocks, opened and closed by ``` or ~~~
infence {
   if (/^ {0,3}(`{3,}|~{3,})[ \t]*$/) {
      f = $0
      gsub(/[ \t]/, "", f)
      if (substr(f, 1, 1) == fencechar && length(f) >= fencelen)
         infence = 0
   }
   next
}
match($0, /^ {0,3}(`{3,}|~{3,})/) {
   f = substr($0, RSTART, RLENGTH)
   gsub(/ /, "", f)
   fencechar = substr(f, 1, 1)
   fencelen = length(f)
   infence = 1
   para = ""
   next
}

# The existing ToC block
isStart($0) { intoc = 1 }
intoc { if (isEnd($0)) intoc = 0; para = ""; next }

# ATX headings: "# Title", "## Title ##"
/^ {0,3}#{1,6}([ \t]|$)/ {
   line = $0
   sub(/^ +/, "", line)
   match(line, /^#+/)
   level = RLENGTH
   t = substr(line, level + 1)
   if (t ~ /^[ \t]*#+[ \t]*$/)
      t = ""
   else
      sub(/[ \t]+#+[ \t]*$/, "", t)
   emit(level, t)
   para = ""
   next
}

# Setext headings: a paragraph underlined with === or ---
para != "" && /^ {0,3}=+[ \t]*$/ { emit(1, para); para = ""; next }
para != "" && /^ {0,3}-+[ \t]*$/ { emit(2, para); para = ""; next }

# Lines that end, or cannot be part of, a paragraph
/^[ \t]*$/                              { para = ""; next }
/^ {0,3}([-*_][ \t]*){3,}$/             { para = ""; next }
/^ {0,3}([-*+]|[0-9]+[.)])([ \t]|$)/    { para = ""; next }
/^ {0,3}[<>]/                           { para = ""; next }
para == "" && /^(    |\t)/              { next }

{ t = trim($0); para = (para == "" ? t : para " " t) }
'

extractHeadings() {
   gawk "$AWK_MARKERS$AWK_HEADINGS" "$1"
}

# The hash covers the headings and the ToC style, so a change to either
# causes the ToC to be regenerated.
generateTOCHash() {
   local file="$1"
   local collapse="$2"
   { echo "collapse=$collapse"; extractHeadings "$file"; } | openssl sha256 | gawk '{ print $NF }'
}

readTOCHash() {
   gawk 'match($0, /<!-- TOC hash is %([0-9a-f]*)% -->/, m) { print m[1]; exit }' "$1"
}

generateTOC() {
   local file="$1"
   local collapse="$2"
   local withMetadata="$3"

   if [ "$collapse" = "yes" ]; then
      echo "<details>"
      echo "  <summary>Table of Contents</summary>"
      echo
   else
      echo "Table of Contents"
      echo "================="
      echo
   fi

   extractHeadings "$file"
   echo

   if [ "$withMetadata" = "yes" ]; then
      echo "<!-- TOC generated at $(date) -->"
      echo "<!-- TOC hash is %$(generateTOCHash "$file" "$collapse")% -->"
      echo
   fi
   if [ "$collapse" = "yes" ]; then
      echo "</details>"
   fi
}

# Prints "none" if the file has no markers, "ok" if it has exactly one
# START line followed by one END line, or an error message otherwise.
checkMarkers() {
   gawk "$AWK_MARKERS"'
      isStart($0) { starts++; if (!startLine) startLine = NR }
      isEnd($0)   { ends++;   if (!endLine) endLine = NR }
      END {
         if (!starts && !ends)             print "none"
         else if (starts != 1 || ends != 1) print "expected exactly one <!-- TOC START --> line and one <!-- TOC END --> line, found " starts + 0 " and " ends + 0
         else if (endLine < startLine)      print "<!-- TOC END --> appears before <!-- TOC START -->"
         else                               print "ok"
      }' "$1"
}

# Adds empty TOC markers at the top of the file, after any front matter.
addMarkers() {
   local file="$1"
   local out
   out=$(newTempFile)
   gawk '
      function markers() { printf "<!-- TOC START -->\n<!-- TOC END -->\n\n"; added = 1 }
      NR == 1 && /^---[ \t]*\r?$/ { fm = 1; print; next }
      fm { print; if (/^(---|\.\.\.)[ \t]*\r?$/) { fm = 0; print ""; markers() } next }
      !added { markers() }
      { print }
      END { if (!added) markers() }
   ' "$file" > "$out" && overwriteFile "$out" "$file"
}

# Returns 0 if the file was updated, 1 if it was already up to date.
replaceInFile() {
   local file="$1"
   local collapse="$2"
   local force="$3"
   local tocFile out

   if [ "$force" != "yes" ] && [ "$(readTOCHash "$file")" = "$(generateTOCHash "$file" "$collapse")" ]; then
      return 1
   fi

   tocFile=$(newTempFile)
   out=$(newTempFile)
   printf '%s\n' "$(generateTOC "$file" "$collapse" yes)" > "$tocFile"
   gawk "$AWK_MARKERS"'
      ARGIND == 1 { toc = toc $0 "\n"; next }
      isStart($0) { print; printf "%s", toc; skipping = 1; next }
      skipping    { if (isEnd($0)) { print; skipping = 0 } next }
      { print }
   ' "$tocFile" "$file" > "$out" || exit 1
   overwriteFile "$out" "$file" || exit 1
   return 0
}

usage() {
   echo "Usage: $PROG [OPTION]... MARKDOWN-FILE"
   echo "Generates a table of contents for a given markdown file."
   echo "The file is modified only if the ToC requires updating."
   echo
   echo "   -h                Usage information"
   echo "   -c                Wrap the ToC with a collapsible <details> element"
   echo "   -a                Add a ToC section to the file if it is missing"
   echo "   -p                Print to stdout, don't update the file"
   echo "   -f                Force an update, even if the ToC hash is correct"
}

################### Main section starts here #####################################

checkDependencies

ADD=
PRINT_TO_STDOUT=
COLLAPSE_TOC=no
FORCE=no
while getopts "hcapf" options; do
   case "${options}" in
      h) usage; exit 0 ;;
      c) COLLAPSE_TOC=yes ;;
      p) PRINT_TO_STDOUT=yes ;;
      a) ADD=yes ;;
      f) FORCE=yes ;;
      *) usage >&2; exit 1 ;;
   esac
done
shift $((OPTIND-1))

FILE="$1"
if [ -z "$FILE" ] || [ $# -gt 1 ]; then
   usage >&2
   exit 1
fi
if [ ! -f "$FILE" ]; then
   echo "$PROG: $FILE: no such file" >&2
   exit 1
fi

if [ -n "$PRINT_TO_STDOUT" ]; then
   generateTOC "$FILE" "$COLLAPSE_TOC" no
   exit 0
fi

echo -n "Updating $FILE..."
MARKERS=$(checkMarkers "$FILE")
case "$MARKERS" in
   ok)
      ;;
   none)
      if [ -z "$ADD" ]; then
         echo "failed - no TOC delimiters found. Maybe use -a ?"
         exit 1
      fi
      addMarkers "$FILE" || exit 1
      ;;
   *)
      echo "failed - $MARKERS"
      exit 1
      ;;
esac

if replaceInFile "$FILE" "$COLLAPSE_TOC" "$FORCE"; then
   echo "done"
else
   echo "already up to date"
fi
